# 环境变量模板 - 复制为 .env 并填入实际值
# 所有变量使用 CODE_REVIEW__ 前缀，双下划线分隔层级

# 服务器
CODE_REVIEW__SERVER__SECRET_KEY=your-secret-key-here

# 数据库
CODE_REVIEW__DATABASE__URL=postgresql+asyncpg://postgres:postgres@localhost:5432/code_review

# Redis
CODE_REVIEW__REDIS__URL=redis://localhost:6379/0

# Celery
CODE_REVIEW__CELERY__BROKER_URL=redis://localhost:6379/1
CODE_REVIEW__CELERY__RESULT_BACKEND=redis://localhost:6379/2

# GitHub
CODE_REVIEW__GITHUB__TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
CODE_REVIEW__GITHUB__WEBHOOK_SECRET=your-github-webhook-secret

# GitLab
CODE_REVIEW__GITLAB__TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
CODE_REVIEW__GITLAB__API_URL=https://gitlab.example.com/api/v4
CODE_REVIEW__GITLAB__WEBHOOK_SECRET=your-gitlab-webhook-secret

# Gitee
CODE_REVIEW__GITEE__TOKEN=your-gitee-token
CODE_REVIEW__GITEE__WEBHOOK_SECRET=your-gitee-webhook-secret

# LLM
CODE_REVIEW__LLM__MODEL=gpt-4
CODE_REVIEW__LLM__API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CODE_REVIEW__LLM__API_BASE=https://api.openai.com/v1

# 飞书
CODE_REVIEW__FEISHU__ENABLED=true
CODE_REVIEW__FEISHU__WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
CODE_REVIEW__FEISHU__SECRET=your-feishu-secret

# 钉钉
CODE_REVIEW__DINGTALK__ENABLED=false
CODE_REVIEW__DINGTALK__WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
CODE_REVIEW__DINGTALK__SECRET=your-dingtalk-secret
